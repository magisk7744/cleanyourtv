<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Or leave it and push a theme instead: tools/theme.sh themes/<name> puts a config.json (same keys, see
  themes/README.md) and an optional wallpaper on the TV, and the launcher overlays it at start.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Tried in order when no standard settings handler is usable; each package must also be visible
         through <queries> in the manifest. -->
    <string-array name="settings_fallback_components" translatable="false">
        <item>com.xiaomi.mitv.settings/com.xiaomi.mitv.settings.entry.MainActivity</item>
        <item>com.tcl.settings/com.tcl.settings.ui.MainActivity</item>
        <item>com.amazon.tv.launcher/com.amazon.tv.launcher.ui.MainSettingsActivity</item>
    </string-array>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.sony.dtv.tvx</item>
        <item>com.ktcp.tvvideo</item>
        <item>com.hpplay.happyplay.aw</item>
        <item>com.trim.tv</item>
    </string-array>
    <!-- With fewer dock_apps than columns (or a dock app that is not installed), the free dock slots take
         the first grid apps, so the dock never shows a gap. false leaves them empty (#162); a theme can
         set "fill_dock": false. -->
    <bool name="fill_dock">true</bool>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Open the Live TV app above the first time Home comes up after the TV is switched on, for sets that are
         mostly used for broadcast TV. Once per boot: Home after that stays Home. Can also be set with
         "boot_to_live_tv": true in a theme's config.json. -->
    <bool name="boot_to_live_tv">false</bool>

    <!-- Some TVs give their Live TV app no leanback entry point at all, so `live_tv_package` above
         resolves to nothing (TCL Android TV 9 on China-market sets is one). This action is then sent
         to that package instead, and the app starts normally. Leave empty to omit. -->
    <string name="live_tv_action" translatable="false"></string>

    <!-- Optional exact system tuner ID for the Inputs menu's Live TV row, e.g. the DVB-S input on
         a TV with separate antenna, cable and satellite tuners. It opens that input's channel
         collection, restricted to live_tv_package. Empty keeps automatic selection and its existing
         OEM passthrough route. If the ID is absent or the app cannot handle the collection, open
         the Live TV app normally instead of selecting a different input. See docs/devices/haam-r4.md. -->
    <string name="live_tv_input_id" translatable="false"></string>

    <!-- Tiles that open a screen of the app instead of its start screen: "package=action", sent to that package.
         A tile whose action no longer resolves opens the app normally. MagentaTV's program guide:
         com.telekom.onetv.tv.pl=com.telekom.onetv.tv.pl.action.PROGRAM_GUIDE. -->
    <string-array name="launch_actions">
    </string-array>

    <!-- A tile's name instead of the app's own: "package=Name". It also shows above the dock. -->
    <string-array name="app_labels">
    </string-array>
    <!-- A tile's artwork instead of the app's banner: "package=drawable", a banner_* drawable bundled with the
         launcher (res/drawable). banner_tv is a magenta field with the Live TV glyph. -->
    <string-array name="app_banners">
    </string-array>

    <!-- TVs with no TvInputManager have no HDMI list to read, but their own source-selection panel
         still switches inputs (TCL Android TV 9 again). When nothing could be listed, the Inputs menu
         offers one row that starts this service: component first, then action. The component can also be an
         activity, for sets whose panel is a dialog (BYINTEK U4). With no Live TV app either, the Inputs pill
         opens the panel directly instead of a menu. Leave empty to omit. -->
    <string name="source_panel_service" translatable="false"></string>
    <string name="source_panel_action" translatable="false"></string>
    <!-- One int extra sent with the source panel intent, "name=value". Coocaa OS (Skyworth, China) needs
         control_center_command=100 for its control center to open on the source row, as the remote's
         Source button does. Leave empty to omit. -->
    <string name="source_panel_extra" translatable="false"></string>

    <!-- Coocaa OS (Skyworth, China) registers no inputs with TvInputManager; com.skyworth.tv lists its
         sources (HDMI 1, HDMI 2, AV, the tuner) through its own provider instead. true: show those in the
         Inputs menu and switch with com.skyworth.tv, ahead of the source panel above, which stays as the
         fallback. See CoocaaSources and examples/skyworth-7s60-a5. -->
    <bool name="coocaa_sources">false</bool>

    <!-- Inputs menu: HDMI and AV rows normally open with ACTION_VIEW on the input's channel URI, which the
         Live TV app handles. Where nothing answers that, this action is sent with the same URI instead
         (XGIMI projectors: com.xgimi.action.hdmiPlayer). Leave empty to omit. -->
    <string name="input_action" translatable="false"></string>
    <!-- Inputs menu: a scheme to send the input's passthrough URI with instead of content:// (and no channel MIME
         type). YaOS: live-tv. Its source player answers live-tv://android.media.tv/passthrough/<input>, while the
         content:// URI goes to its channel player, which resumes the last film it played. Leave empty to omit. -->
    <string name="input_uri_scheme" translatable="false"></string>

    <!-- Whether HomeKeyService and InputKeyService actually request key filtering (config.xml or a theme's
         "key_filter"). Some firmware (TCL Google TV on Android 12) drops key auto-repeat once ANY service
         filters keys, so long-pressing volume only steps once: set false and the service keeps running but
         stops filtering, which brings repeat back at the price of the remote buttons below doing nothing. -->
    <bool name="key_filter">true</bool>

    <!-- Vendor source numbers for the Inputs menu, "HW<n>=<number>" by the framework input id's last part
         (`tools/tv.py 'dumpsys tv_input'` lists them). A mapped input opens by sending input_action with the
         number as the int extra "input"; "HW<n>=-" leaves a port the board reports but the set does not have
         out of the menu. Xiaomi/Redmi China firmware (MiTV-MFTP0) needs input_action
         com.xiaomi.mitv.tvplayer.EXTSRC_PLAY and MStar numbers: HW5=23, HW6=24, HW7=25, HW8=-, HW2=2,
         HW3=-, HW4=- (see examples/redmi-mitv-mftp0). Leave empty to omit. -->
    <string-array name="input_sources" translatable="false">
    </string-array>

    <!-- Remote buttons that open Settings, by Linux scancode (HOME_KEY_SERVICE=1 build-and-install.sh). Remotes
         that send KEYCODE_SETTINGS need no entry. Some send a code Android does not map: the Xiaomi/Fengmi
         projector remote's gear button is scancode 384 (KEY_TAPE). Find yours with
         `tools/tv.py 'getevent -lt'` while pressing the button - but a HID consumer-control usage prints an
         evdev MSC_SCAN there, which is not always the scanCode the framework reports, so a number that takes
         nothing is no proof the press never arrived. Leave empty to omit. -->
    <integer-array name="settings_key_scancodes">
    </integer-array>
    <!-- The same by Android keycode, for buttons whose scancode is shared. TCL Google TV remotes send their
         Settings button as keycode 83 (KEYCODE_NOTIFICATION, which the stock Google TV home turned into its quick
         settings panel) on scancode 240 (KEY_UNKNOWN), the scancode several TCL buttons share. Find the keycode
         with `tools/tv.py 'logcat -v time -s InputReader:D'` while pressing the button - some firmwares print no
         key line there at any verbosity, and a `getevent` MSC_SCAN is a different number, so the reliable route is
         a temporary `Log.d` in the helper's `onKeyEvent`: `getKeyCode()`, `getScanCode()`, `getDeviceId()`, read
         after a HOME_KEY_SERVICE=1 rebuild. Leave empty to omit. -->
    <integer-array name="settings_key_keycodes">
    </integer-array>
    <!-- What those Settings buttons open: false, the TV's Settings; true, a small glass panel at the top right
         with TV settings, Display, Network, Apps (re-enable an app) and Launcher settings, over whatever is on screen.
         Both keys can also be set from a theme's config.json ("settings_key_keycodes": [83]). -->
    <bool name="settings_key_panel">false</bool>

    <!-- A force stop of the launcher (Settings, a cleaner app, am force-stop) takes HomeKeyService and InputKeyService
         off the enabled list. true: Home puts the helpers that were running back when it starts; one turned off in
         Settings stays off. Needs WRITE_SECURE_SETTINGS, which build-and-install grants with RESTORE_KEY_SERVICES=1
         (-RestoreKeyServices on Windows). Can also be set with "restore_key_services": true in a theme's config.json. -->
    <bool name="restore_key_services">false</bool>

    <!-- More remote buttons that open the input switcher, by Android keycode (INPUT_KEY_SERVICE=1
         build-and-install.sh; KEYCODE_TV always does). For buttons only a disabled app answered: the Xiaomi
         MiTV-AXFR2 remote's PatchWall button is 192 (KEYCODE_BUTTON_5). `dumpsys window policy` lists which
         app each such "global key" was routed to. Check with the real remote: keys injected over ADB never
         reach InputKeyService. Leave empty to omit. -->
    <integer-array name="input_key_keycodes">
    </integer-array>
    <!-- Answer the system input switcher (com.android.tv.action.VIEW_INPUTS) with the Inputs menu. For TVs whose
         stock launcher was the only handler of that action, so the remote's Input button does nothing once the
         stock launcher is disabled even with InputKeyService on (Hisense huangshan, Android TV 10: no
         global_keys.xml, no vendor input picker). Off by default: a TV with its own input picker would otherwise
         get a chooser on every press. Also "handle_view_inputs": true in a theme's config.json. -->
    <bool name="handle_view_inputs">false</bool>
    <!-- Remote buttons that open an app, as "keycode:package" or "KEYCODE_NAME:package" (INPUT_KEY_SERVICE=1 or
         HOME_KEY_SERVICE=1; both read this one list, and a theme's config.json can set it too). -->
    <string-array name="app_keys" translatable="false">
    </string-array>

    <!-- Package of the stock launcher, for TVs whose firmware turns it back on after it was disabled. -->
    <string name="stock_home_redirect" translatable="false"></string>

    <!-- Show the Solar Hijri (Shamsi) date used in Iran and Afghanistan, e.g. "27 Mehr 1405", above the
         Gregorian date. -->
    <bool name="shamsi_date">false</bool>

    <!-- A name after the greeting: "Mr. Trịnh" shows GOOD MORNING, MR. TRỊNH. Empty: the greeting alone. -->
    <string name="greeting_name" translatable="false"></string>
    <!-- Optional VPN app the network pill opens (hold the pill for Wi-Fi settings). -->
    <string name="vpn_app" translatable="false"></string>
    <!-- The dock as its own row: a lighter band, no names under the tiles. -->
    <bool name="dock_row">true</bool>
    <!-- Inputs, Wi-Fi and Settings folded into one round gear at the top right. -->
    <bool name="top_menu">false</bool>
    <!-- A direct Launcher settings action instead of TV Settings in the header. -->
    <bool name="launcher_settings_button">false</bool>
    <!-- The dock band as light frosted glass. -->
    <bool name="dock_glass">false</bool>
    <!-- A reorder button (two arrows) in the top bar. -->
    <bool name="reorder_button">false</bool>
    <!-- Wi-Fi and Settings as round icon-only buttons. -->
    <bool name="icon_only_buttons">false</bool>
    <!-- The app library as a round button in the top bar, beside Settings. -->
    <bool name="library_button">false</bool>
    <integer name="wifi_label_width">0</integer>

    <!-- The Wi-Fi/Ethernet pill in the top bar. -->
    <bool name="show_network_pill">true</bool>
    <!-- The Inputs pill in the top bar, shown when the TV has inputs to list. -->
    <bool name="show_inputs_pill">true</bool>
    <!-- Names under every tile, not only the focused one. -->
    <bool name="always_show_names">false</bool>
    <bool name="wallpaper_true_color">false</bool>
    <bool name="wallpaper_captions">false</bool>

    <!-- 【核心修改项】：设置为 true，长按 OK 键即弹出 Move（移动）与排序菜单 -->
    <bool name="tile_menu">true</bool>

    <!-- Grid rows left visible under the dock on the home screen. 0 = dock sits at the very bottom. -->
    <integer name="rows_below_dock">0</integer>

    <!-- The focused dock app's name in large type above the dock. -->
    <bool name="dock_title">true</bool>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>

    <!-- Basic motion is on; advanced effects are opt-in in the launcher's own Settings screen. -->
    <bool name="animations">true</bool>
    <bool name="advanced_effects">false</bool>

    <bool name="show_home_settings_shortcut">false</bool>

    <!-- 【核心修改项】：设置为 true，支持应用库和从主页移除应用功能 -->
    <bool name="app_library">true</bool>

    <bool name="module_cards">true</bool>
    <bool name="reduced_motion">false</bool>
    <bool name="focus_overshoot">true</bool>
    <bool name="show_stats">false</bool>

    <integer name="sky_intensity">0</integer>
    <string name="latitude" translatable="false"></string>
    <string name="longitude" translatable="false"></string>

    <bool name="cinematic_home">false</bool>
    <bool name="ambient_glow">true</bool>
    <bool name="app_glow">false</bool>
    <integer name="home_idle_clock_minutes">0</integer>
    <string name="glow_style" translatable="false">radial</string>
</resources>
